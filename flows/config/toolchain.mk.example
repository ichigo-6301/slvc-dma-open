# Copy this file to flows/local/toolchain.mk for local overrides. Do not commit it.
# Public commands use `make <stage>`; command-line assignments override this file.
# CONFIG, LOCAL_CONFIG, and DEFCONFIG paths are relative to the repository root
# unless absolute. Backslashes are normalized; drive, rooted, and UNC paths
# remain absolute. Tool values are literal argv prefixes, not shell commands.
PYTHON ?= python3
KCONFIG_MCONF ?= mconf
VSIM ?= vsim
VIVADO ?= vivado
VIVADO_2022_2 ?= vivado
DC_SHELL ?= dc_shell
PT_SHELL ?= pt_shell

# Fixed startup flags are supported. Quote executable paths that contain spaces:
# VSIM := vsim -64
# DC_SHELL := dc_shell -64
# VIVADO_2022_2 := "C:/Program Files/Xilinx/Vivado/2022.2/bin/vivado.bat" -nolog -nojournal
# Pipes, redirects, command chaining, and tool paths containing |&;<> are rejected.
DMA_N45_STDCELL_DB ?=
DMA_N45_LIBERTY ?=
DMA_ORFS_ROOT ?=

# Optional ignored build/handoff overrides for the C2B4 implementation profile.
DMA_C2_BUILD_ROOT ?=
DMA_C2_MAPPED_NETLIST ?=
DMA_C2_ALLOW_UNMEASURED_ROUTE ?=
DMA_DC_MAX_CORES ?=

export VIVADO VIVADO_2022_2 DC_SHELL PT_SHELL
export DMA_N45_STDCELL_DB DMA_N45_LIBERTY DMA_ORFS_ROOT
